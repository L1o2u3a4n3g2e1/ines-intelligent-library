# ============================================================================
# DIGITAL LIBRARY AI SERVICE - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and customize for your environment
# IMPORTANT: Never commit .env to version control
# ============================================================================

# ============================================================================
# JWT AUTHENTICATION CONFIGURATION
# ============================================================================

# Secret key for signing JWT tokens
# PRODUCTION: Generate a strong random key (minimum 32 characters)
# Generate with: [System.Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes((1..32 | ForEach-Object {[char](Get-Random -Minimum 33 -Maximum 126)})))
JWT_SECRET_KEY=your-production-secret-key-minimum-32-characters-long

# JWT token expiration time (in hours)
# Default: 24 hours
JWT_EXPIRATION_HOURS=24

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Environment mode (development or production)
# In production mode, CORS is restricted to ALLOWED_ORIGIN only
ENVIRONMENT=development

# Allowed origin for CORS requests
# PRODUCTION: Set to your actual domain (e.g., https://yourdomain.com)
# Default: localhost for development
ALLOWED_ORIGIN=http://localhost

# ============================================================================
# SSL/HTTPS CONFIGURATION
# ============================================================================

# Path to SSL certificate file (for HTTPS support)
# Generate with: .\generate_certificates.ps1
# Leave empty for HTTP only (development)
# Example: SSL_CERT_FILE=cert.pem
SSL_CERT_FILE=

# Path to SSL private key file (for HTTPS support)
# Generated with: .\generate_certificates.ps1
# Leave empty for HTTP only (development)
# Example: SSL_KEY_FILE=key.pem
SSL_KEY_FILE=

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================

# FastAPI host address
# development: 127.0.0.1 (localhost only)
# production: 0.0.0.0 (accessible from network)
FASTAPI_HOST=127.0.0.1

# FastAPI port
# Default: 8000
FASTAPI_PORT=8000

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Token generation limit (requests per minute)
# Default: 10 per minute
TOKEN_RATE_LIMIT=10/minute

# Health check limit (requests per minute)
# Default: 100 per minute
HEALTH_RATE_LIMIT=100/minute

# Translation limit (requests per hour)
# Default: 100 per hour
TRANSLATE_RATE_LIMIT=100/hour

# TTS limit (requests per hour)
# Default: 50 per hour
TTS_RATE_LIMIT=50/hour

# STT limit (requests per hour)
# Default: 10 per hour
STT_RATE_LIMIT=10/hour

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=server.log

# Maximum log file size (in bytes)
LOG_MAX_SIZE=10485760  # 10MB

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Enable API authentication (requires JWT token)
# Default: true (always enabled in production)
REQUIRE_AUTH=true

# Enable rate limiting
# Default: true
ENABLE_RATE_LIMITING=true

# Enable HTTPS enforcement
# Default: false for development, should be true for production
ENFORCE_HTTPS=false

# ============================================================================
# DEVELOPMENT SETTINGS (Not for production)
# ============================================================================

# Enable debug mode (shows detailed error messages)
# PRODUCTION: Set to false
DEBUG=true

# Allow insecure SSL certificates (self-signed)
# PRODUCTION: Set to false
ALLOW_INSECURE_SSL=true

# ============================================================================
# QUICK START TEMPLATES
# ============================================================================

# DEVELOPMENT SETUP
# Copy and paste to .env for local testing:
#
# ENVIRONMENT=development
# JWT_SECRET_KEY=development-secret-key-do-not-use-in-production
# ALLOWED_ORIGIN=http://localhost
# DEBUG=true
# ALLOW_INSECURE_SSL=true

# PRODUCTION SETUP
# Copy and paste to .env for production deployment:
#
# ENVIRONMENT=production
# JWT_SECRET_KEY=your-strong-random-production-key-minimum-32-chars
# ALLOWED_ORIGIN=https://yourdomain.com
# SSL_CERT_FILE=/path/to/cert.pem
# SSL_KEY_FILE=/path/to/key.pem
# DEBUG=false
# ALLOW_INSECURE_SSL=false
# ENFORCE_HTTPS=true
# FASTAPI_HOST=0.0.0.0
